# Copy this file to `.env.local` and fill it in. `.env.local` is gitignored; this one is not,
# so it must never contain a real key.
#
# Every variable here is OPTIONAL. With none of them set the studio still works end to end —
# you position your face by hand and the quality check is the deterministic one. The AI only
# ever adds convenience, so a missing key disables a feature rather than breaking the app.
#
# NOTHING here is prefixed NEXT_PUBLIC_, and nothing may be: these are read exclusively in
# route handlers under app/api. A key in a NEXT_PUBLIC_ variable is shipped to every visitor's
# browser and is public the moment it deploys.

# ── Groq — primary, free tier ──────────────────────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=

# Text model, for turning a freeform description into signature fields.
GROQ_MODEL_TEXT=openai/gpt-oss-120b

# Vision model, for judging the photo and the rendered frame. It has to be a separate entry:
# gpt-oss is TEXT-ONLY on Groq, so sending it an image fails. Verified 2026-07-29 against
# https://console.groq.com/docs/vision — qwen3.6-27b is currently the only image-capable model
# Groq serves, and it supports JSON mode and tool use (max 5 images, 20 MB per request).
GROQ_MODEL_VISION=qwen/qwen3.6-27b

# ── Anthropic — fallback only ──────────────────────────────────────────────────────────────
# Used when Groq rate-limits, errors, or times out. Leave empty to have failures simply
# degrade to "AI unavailable" instead of costing money.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Caps ───────────────────────────────────────────────────────────────────────────────────
# A public tool with no accounts is a public tool with no spend limit unless one is written
# down. Set this in the Anthropic Console as well — code-side ceilings only stop the calls
# this code makes.
AI_MONTHLY_BUDGET_USD=10
AI_REQUESTS_PER_IP_PER_HOUR=20
